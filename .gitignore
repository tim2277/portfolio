# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env*
!.env.example

# HEIC originals - convert with scripts/Convert-Heic.ps1 before anything
# lands in src/assets. core.ignorecase is true by default on Windows/macOS
# checkouts, so one pattern covers both cases there; listed twice anyway so
# a case-sensitive checkout (Linux CI) doesn't miss the uppercase form.
*.heic
*.HEIC

# Playwright MCP screenshots and traces
.playwright-mcp/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Narration working files: per-segment cache, stitched takes, timelines
.narration/

# Sound effects for narration. Their licence allows them in a recording and forbids passing
# them on as bare files, which a public repo would be doing. narration/effects.json is the
# tracked record of what each one is and where to download it again.
narration/effects/
