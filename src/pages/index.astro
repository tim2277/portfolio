---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EntryList from '../components/EntryList.astro';
import { getPosts, getProjects } from '../lib/content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getPosts()).slice(0, 5);
const projects = (await getProjects()).slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Hero title="Hello — I'm Tim" eyebrow="Engineer · Ireland">
    <p>I build things. Occasionally I write down how it went.</p>
  </Hero>

  <p>
    Mechatronics and robotics first, then an MSc in AI, with .NET running through the middle of it since 2005.
    My day job is distributed Blazor applications; my attention keeps drifting to the seam between engineering practice and tooling — and to where AI agents genuinely earn their keep in a delivery workflow, rather than just making a mess faster.
  </p>
  <p>
    This is where that gets written down. Architecture notes, agent workflows in the SDLC, and the occasional post-mortem on something that didn't work.
    Concepts and write-ups only — nothing here is employer code.
  </p>

  <h2>Latest posts</h2>
  <EntryList entries={posts} base="/posts" emptyMessage="No posts published yet." />
  <p><a href="/posts/">All posts →</a></p>

  <h2>Projects</h2>
  <EntryList entries={projects} base="/projects" emptyMessage="No projects published yet." />
  <p><a href="/projects/">All projects →</a></p>
</BaseLayout>
