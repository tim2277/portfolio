---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EntryCards from '../components/EntryCards.astro';
import { getPosts, getProjects } from '../lib/content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import heroImage from '../assets/photos/home-hero.jpg';

// Even counts: the cards sit two to a row, and an odd one out leaves a hole.
const posts = (await getPosts()).slice(0, 4);
const projects = (await getProjects()).slice(0, 4);

// Same 1200x630 jpeg treatment the entry pages get — see EntryLayout.
const share = await getImage({
  src: heroImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  image={share.src}
  imageAlt="A floodlit medieval tower house against a deep purple dusk sky, its stone lit warm amber."
  imageWidth={1200}
  imageHeight={630}
  width="shell"
>
  <Hero
    slot="hero"
    title="Hello - I’m Tim"
    eyebrow="Engineer · Ireland"
    image={heroImage}
    imageAlt="A floodlit medieval tower house against a deep purple dusk sky, its stone lit warm amber."
    imagePosition="50% 28%"
  >
    <p>I build things. Occasionally I write down how it went.</p>
  </Hero>

  {/* Prose keeps the measure even though the page is shell-width — one column narrow, two columns wide. */}
  <div class="home-intro">
    <p>
      Mechatronics and robotics first, then an MSc in AI, and .NET running through the middle of it all since 2005.
      The day job is distributed Blazor applications.
      The bit I can’t leave alone is where AI agents earn their keep in a team’s delivery process, and where they just make a mess faster.
    </p>
    <p>
      This is where it gets written down (for once).
      What worked, what didn’t, and whatever I built at home because it annoyed me enough.
      Concepts and write-ups only - no work code here.
      Code that is mine, I’ve finally <a href="https://github.com/tim2277/wrote-it-down" target="_blank">wrote-it-down</a>.
    </p>
  </div>

  <section class="home-section">
    <h2>Latest posts</h2>
    <EntryCards entries={posts} base="/posts" emptyMessage="No posts published yet." />
    <p><a href="/posts/">All posts →</a></p>
  </section>

  <section class="home-section">
    <h2>Projects</h2>
    <EntryCards entries={projects} base="/projects" emptyMessage="No projects published yet." />
    <p><a href="/projects/">All projects →</a></p>
  </section>

  <style>
    .home-intro {
      max-width: var(--measure);
    }

    /* Two columns only where each still gets a sane line length — below that
       they stack, which is what the single-column layout already did. */
    @media (min-width: 60rem) {
      /* Paragraphs move whole: one split across the gutter reads as a
         typesetting accident. */
      .home-intro {
        max-width: none;
        columns: 2;
        column-gap: 3rem;
      }

      .home-intro p {
        break-inside: avoid;
      }
    }

    .home-section h2 {
      margin-block-start: 2.5rem;
    }

    .home-section > p {
      margin-block-start: 1.25rem;
    }
  </style>
</BaseLayout>
