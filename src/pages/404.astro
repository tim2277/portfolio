---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page doesn't exist." noindex suppressUrl>
  <h1>404 — not here</h1>
  <p class="lede">That page doesn't exist, or it moved and I didn't leave a redirect.</p>
  <p>
    Try the <a href="/posts/">posts index</a>, the <a href="/projects/">projects index</a>, or head <a href="/">home</a>.
  </p>
</BaseLayout>
