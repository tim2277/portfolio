---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Panel from '../components/Panel.astro';
import TableOfContents from '../components/TableOfContents.astro';
import heroImage from '../assets/photos/about-hero.jpg';
// The prose is MDX so it gets what a post gets: footnotes, curled quotes, and
// headings the contents list can read. A .astro page has none of the three.
import { Content, getHeadings } from '../content/pages/about.mdx';

const headings = getHeadings();

const share = await getImage({
  src: heroImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
---

<BaseLayout
  title="About"
  description="Two decades shipping software, and rather less time writing about it. Robotics, .NET, and where AI agents actually fit into a delivery workflow."
  image={share.src}
  imageAlt="A lone figure in an orange jacket standing on a snowfield, back to the camera, facing a ridge under flat white cloud."
  imageWidth={1200}
  imageHeight={630}
  width="shell"
>
  <Hero
    slot="hero"
    title="About"
    eyebrow="Who’s writing this"
    image={heroImage}
    imageAlt="A lone figure in an orange jacket standing on a snowfield, back to the camera, facing a ridge under flat white cloud."
    ratio="3.2 / 1"
    imagePosition="50% 52%"
  >
    <p>Why write when you can show? Then agentic dev came along, and the excuses stopped working.</p>
  </Hero>

  <div class="toc-layout">
    <div>
      <Panel title="At a glance">
        <dl>
          <dt>Based</dt><dd>Ireland</dd>
          <dt>Background</dt><dd>BSc Eng Mechatronics &amp; Robotics, MSc AI</dd>
          <dt>Works on</dt><dd>Backend and platform</dd>
          <dt>Writes about</dt><dd>Engineering, Software, AI Agents</dd>
        </dl>
      </Panel>

      <Content />
    </div>

    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
