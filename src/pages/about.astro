---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Panel from '../components/Panel.astro';
import TableOfContents from '../components/TableOfContents.astro';
import heroImage from '../assets/photos/about-hero.jpg';

/*
  A .astro page has no `render()`, so headings can't be discovered the way an
  entry's are. Declaring them here keeps one source: the <h2>s below take their
  text and id from this list, so renaming a section renames both.
*/
const sections = [
  { slug: 'what-i-work-on', text: 'What I work on' },
  { slug: 'ai-ops', text: 'AI Ops' },
  { slug: 'when-im-not-engineering', text: 'When I’m not engineering' },
  { slug: 'what-you-wont-find-here', text: 'What you won’t find here' },
  { slug: 'elsewhere', text: 'Elsewhere' },
] as const;

const headings = sections.map((s) => ({ depth: 2, slug: s.slug, text: s.text }));
const section = (slug: (typeof sections)[number]['slug']) => sections.find((s) => s.slug === slug)!;

const share = await getImage({
  src: heroImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
---

<BaseLayout
  title="About"
  description="Two decades shipping software, and rather less time writing about it. Robotics, .NET, and where AI agents actually fit into a delivery workflow."
  image={share.src}
  imageAlt="A lone figure in an orange jacket standing on a snowfield, back to the camera, facing a ridge under flat white cloud."
  imageWidth={1200}
  imageHeight={630}
  width="shell"
>
  {/* Portrait source: a taller band and a raised focal point, or the 4.5:1
      default crops the figure off at the shoulders. */}
  <Hero
    slot="hero"
    title="About"
    eyebrow="Who’s writing this"
    image={heroImage}
    imageAlt="A lone figure in an orange jacket standing on a snowfield, back to the camera, facing a ridge under flat white cloud."
    ratio="3.2 / 1"
    imagePosition="50% 52%"
  >
    <p>Why write when you can show? Then agentic dev came along, and the excuses stopped working.</p>
  </Hero>

  <div class="toc-layout">
    <div>
      <Panel title="At a glance">
        <dl>
          <dt>Based</dt><dd>Ireland</dd>
          <dt>Background</dt><dd>BSc Eng Mechatronics &amp; Robotics, MSc AI</dd>
          <dt>Works on</dt><dd>Backend and platform</dd>
          <dt>Writes about</dt><dd>Engineering, Software, AI Agents</dd>
        </dl>
      </Panel>

      <p>
        I’m an engineer. I started in Mechatronics and Robotics and progressed into an MSc in Artificial Intelligence.
        I’ve spent a long time building, creating, designing, and shipping things, but significantly less time writing about it.
      </p>
      <p>
        After years of “too much work”, “who’s going to maintain it” and “social media posts are boring”, along came agentic dev and the excuses stopped working.
      </p>

      <h2 id={section('what-i-work-on').slug}>{section('what-i-work-on').text}</h2>
      <p>
        I’ve extensive experience in developing and architecting .NET Applications.
        I’ve been with .NET since 2005, while being relatively competent in C++/C for robotics and IoT applications.
        My day job’s focus is distributed .NET Blazor applications.
      </p>
      <p>
        As I’ve advanced my career I’ve had a steady interest in the seam between engineering practice, ISO standards (27001, looking at you), and tooling — the parts of delivery that quietly decide whether a team ships monthly or quarterly or not at all because a change breaks all access controls!
      </p>

      <h2 id={section('ai-ops').slug}>{section('ai-ops').text}</h2>
      <p>
        The other half of what I write about here. Not “AI will write your code”, but the more interesting and less glamorous question: where do agents actually fit into an existing SDLC? Review, triage, migration, test scaffolding, documentation that stays current.
        What needs a human gate, what doesn’t, and what breaks when you get that boundary wrong.
      </p>
      <p>
        I’m sceptical by default and reasonably well-calibrated about it.
        Things that work get written up; so do the things that didn’t.
      </p>

      <h2 id={section('when-im-not-engineering').slug}>{section('when-im-not-engineering').text}</h2>
      <p>
        When I’m not engineering you can find me exploring the latest RPGs on Xbox, PC, or Switch 2 <span role="img" aria-label="game controller">🎮</span>
      </p>
      <p>
        Or planning my next holiday <span role="img" aria-label="plane">✈️</span>
      </p>

      <h2 id={section('what-you-wont-find-here').slug}>{section('what-you-wont-find-here').text}</h2>
      <p>
        Any employer code. Everything on this site is concepts, patterns and write-ups — generalised deliberately, and written from my own projects where there’s code to show.
      </p>

      <h2 id={section('elsewhere').slug}>{section('elsewhere').text}</h2>
      <ul>
        <li><a href="https://github.com/tim2277" rel="me">GitHub</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
      </ul>
    </div>

    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
