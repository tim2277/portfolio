---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import EntryCards from '../../components/EntryCards.astro';
import { getProjects } from '../../lib/content';
import heroImage from '../../assets/photos/projects-hero.jpg';

const projects = await getProjects();

const share = await getImage({
  src: heroImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
---

<BaseLayout
  title="Projects"
  description="Things I’ve built - write-ups of the interesting decisions rather than a gallery of screenshots."
  image={share.src}
  imageAlt="A terraced limestone hill under a wide cloudy sky, bare grey rock pavement running down to scrub and water."
  imageWidth={1200}
  imageHeight={630}
  width="shell"
>
  <Hero
    slot="hero"
    title="Projects"
    eyebrow="Things I’ve built"
    image={heroImage}
    imageAlt="A terraced limestone hill under a wide cloudy sky, bare grey rock pavement running down to scrub and water."
  >
    <p>
      Things I’ve built, half-built, or thought about. These are write-ups of the interesting decisions rather than a gallery of screenshots.
    </p>
  </Hero>

  <EntryCards
    entries={projects}
    base="/projects"
    emptyMessage="No projects published yet. Watch this space."
    headingLevel={2}
    columns={1}
  />
</BaseLayout>
