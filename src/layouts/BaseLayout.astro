---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_LOCALE } from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
  /** 'shell' widens the content column to match the header, for pages that
      put something beside the prose. The prose itself stays at --measure. */
  width?: 'measure' | 'shell';
}

const { width = 'measure', ...props } = Astro.props;

// The only client-side JavaScript on the site. It runs before <body> parses so
// an explicit theme choice is applied before first paint — deferring it would
// flash the OS theme first. `is:inline` keeps Astro from bundling it, which
// also keeps the bytes stable: the CSP in public/staticwebapp.config.json
// carries a sha256 of exactly this text, so editing it means recomputing the
// hash or the script stops running. See AGENTS.md.
---

<!doctype html>
<html lang={SITE_LOCALE}>
  <head>
    <BaseHead {...props} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const mq = matchMedia('(prefers-color-scheme: dark)');
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        if (stored === 'light' || stored === 'dark') root.dataset.theme = stored;

        const current = () => root.dataset.theme || (mq.matches ? 'dark' : 'light');

        // Shows the theme you'd get by clicking, not the one you're in.
        // Escaped codepoints keep this file ASCII — the CSP hashes its bytes.
        const label = (btn) => {
          const next = current() === 'dark' ? 'light' : 'dark';
          const icon = btn.querySelector('.theme-icon');
          if (icon) icon.textContent = next === 'dark' ? '\u{1F319}' : '\u{2600}\u{FE0F}';
          btn.setAttribute('aria-label', `Switch to the ${next} theme`);
          btn.setAttribute('title', `Switch to the ${next} theme`);
        };

        addEventListener('DOMContentLoaded', () => {
          const btn = document.querySelector('.theme-toggle');
          if (!btn) return;
          btn.hidden = false;
          label(btn);
          btn.addEventListener('click', () => {
            const next = current() === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            try {
              localStorage.setItem('theme', next);
            } catch {}
            label(btn);
          });
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot name="hero" />
      <div class:list={['wrap', width === 'shell' && 'wrap-shell']}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
