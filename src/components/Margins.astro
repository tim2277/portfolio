---
interface Props {
  /** Match the page's content column, so the motif stops where the content starts. */
  clear?: 'measure' | 'shell';
}

const { clear = 'measure' } = Astro.props;

// `animation-timeline: scroll(root)` would do this without a script, and did.
// Swiping repeatedly past the end of the page on a touchpad then made Edge stop
// drawing the page for a second or more at a time, with nothing busy and no
// error. The script's bytes are pinned by hash in the CSP: edit it and
// recompute, or it stops running.
---

<div class:list={['margins', `margins-${clear}`]} aria-hidden="true">
  <div class="margins-layer margins-far"></div>
  <div class="margins-layer margins-mid"></div>
  <div class="margins-layer margins-near"></div>
</div>

<script is:inline>
  (() => {
    const margins = document.querySelector('.margins');
    const root = document.documentElement;

    // Clamped: a browser that rubber-bands reports a scroll position outside
    // the page, and the layers are only tall enough to cover their own drift.
    const update = () => {
      const max = root.scrollHeight - root.clientHeight;
      const scrolled = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      margins.style.setProperty('--scrolled', String(scrolled));
    };

    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  })();
</script>

<style>
  /* Decoration for the empty margins of a wide display. Fixed behind
     everything and masked out across the content column, so nothing ever
     sits under text. The tiles come from src/pages/motif-[layer].svg.ts. */
  .margins {
    display: none;
  }

  @media (min-width: 64rem) {
    .margins {
      --clear: var(--measure);
      --edge: calc(var(--clear) / 2 + var(--gutter));
      display: block;
      position: fixed;
      inset: 0;
      z-index: -1;
      overflow: hidden;
      pointer-events: none;
      mask-image: linear-gradient(
        to right,
        #000 0,
        #000 calc(50% - var(--edge) - 3rem),
        transparent calc(50% - var(--edge)),
        transparent calc(50% + var(--edge)),
        #000 calc(50% + var(--edge) + 3rem),
        #000 100%
      );
    }

    .margins-shell {
      --clear: var(--shell);
    }
  }

  /* Taller than the viewport by its own drift, so sliding it up never
     uncovers a bare strip at the foot. The tile is a mask over a block of
     accent colour: the file carries the shapes, the page carries the colour. */
  .margins-layer {
    position: absolute;
    inset: 0 0 calc(-1 * var(--drift));
    background: var(--accent);
    mask-repeat: repeat;
  }

  .margins-far {
    --drift: 6rem;
    opacity: 0.13;
    mask-image: url('/motif-far.svg');
  }

  .margins-mid {
    --drift: 14rem;
    opacity: 0.2;
    mask-image: url('/motif-mid.svg');
  }

  .margins-near {
    --drift: 26rem;
    opacity: 0.3;
    mask-image: url('/motif-near.svg');
  }

  /* The fallback of 0 is the no-script case: without --scrolled, or with
     reduced motion, the layers stand still where they were drawn. */
  @media (prefers-reduced-motion: no-preference) {
    .margins-layer {
      transform: translateY(calc(var(--scrolled, 0) * -1 * var(--drift)));
    }
  }

  @media print {
    .margins {
      display: none;
    }
  }
</style>
