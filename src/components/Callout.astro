---
interface Props {
  type?: 'note' | 'warning' | 'tip';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const labels = { note: 'Note', warning: 'Watch out', tip: 'Tip' } as const;
---

<aside class={`callout callout-${type}`}>
  <p class="callout-label">{title ?? labels[type]}</p>
  <slot />
</aside>

<style>
  .callout {
    border: 1px solid var(--border);
    border-inline-start: 3px solid var(--accent);
    border-radius: 4px;
    background: var(--bg-subtle);
    padding: 0.9rem 1.1rem;
    margin-block: 1.5rem;
  }

  .callout :global(p:last-child) {
    margin-block-end: 0;
  }

  .callout-label {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-block-end: 0.35rem;
  }

  .callout-warning {
    border-inline-start-color: #c2410c;
  }

  .callout-warning .callout-label {
    color: #c2410c;
  }

  /* Two routes, same as the palette in global.css: OS preference when the
     reader hasn't chosen, [data-theme] when they have. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .callout-warning {
      border-inline-start-color: #fb923c;
    }

    :root:not([data-theme='light']) .callout-warning .callout-label {
      color: #fb923c;
    }
  }

  :root[data-theme='dark'] .callout-warning {
    border-inline-start-color: #fb923c;
  }

  :root[data-theme='dark'] .callout-warning .callout-label {
    color: #fb923c;
  }
</style>
