---
import { NAV_LINKS, SITE_WORDMARK } from '../consts';

// Trailing slashes are normalised so '/posts' and '/posts/' both match, and
// a post page marks its section ('/posts/foo/' -> Posts) as current.
const path = `/${Astro.url.pathname.replace(/^\/|\/$/g, '')}/`.replace('//', '/');

const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap">
    <a class="site-name" href="/">
      <svg
        class="site-mark"
        viewBox="0 0 32 32"
        fill="none"
        stroke="currentColor"
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M10 6.5H5.5v19H10" />
        <path d="M22 6.5h4.5v19H22" />
        <circle cx="12.5" cy="12.5" r="2.3" fill="currentColor" stroke="none" />
        <circle cx="19.5" cy="12.5" r="1.7" stroke-width="1.4" />
        <circle cx="12.5" cy="19.5" r="1.7" stroke-width="1.4" />
        <circle cx="19.5" cy="19.5" r="2.3" fill="currentColor" stroke="none" />
      </svg>
      {SITE_WORDMARK}
    </a>

    <div class="site-tools">
      <nav class="site-nav" aria-label="Primary">
        {
          NAV_LINKS.filter((link) => link.href !== '/').map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
      {/* Icon and [hidden] are set by the inline script in BaseLayout. The
          emoji is aria-hidden so the name comes from aria-label — 'sun with
          face' announced aloud helps nobody. */}
      <button class="theme-toggle" type="button" hidden>
        <span class="theme-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
