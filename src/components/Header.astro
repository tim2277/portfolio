---
import { NAV_LINKS, SITE_AUTHOR } from '../consts';

// Trailing slashes are normalised so '/posts' and '/posts/' both match, and
// a post page marks its section ('/posts/foo/' -> Posts) as current.
const path = `/${Astro.url.pathname.replace(/^\/|\/$/g, '')}/`.replace('//', '/');

const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap">
    <a class="site-name" href="/">{SITE_AUTHOR}</a>
    <nav class="site-nav" aria-label="Primary">
      {
        NAV_LINKS.filter((link) => link.href !== '/').map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
