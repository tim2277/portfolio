---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<aside class="panel">
  {title && <p class="panel-title">{title}</p>}
  <slot />
</aside>

<style>
  .panel {
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-subtle);
    padding: 1.1rem 1.25rem;
    margin-block: 2rem;
  }

  .panel-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent);
    margin: 0 0 0.8rem;
  }

  /* Label/value rows. Falls back to a readable stack on narrow screens. */
  .panel :global(dl) {
    display: grid;
    grid-template-columns: minmax(6rem, max-content) 1fr;
    gap: 0.5rem 1.25rem;
    margin: 0;
  }

  .panel :global(dt) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .panel :global(dd) {
    margin: 0;
  }

  .panel :global(p:last-child),
  .panel :global(ul:last-child) {
    margin-block-end: 0;
  }

  @media (max-width: 30rem) {
    .panel :global(dl) {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .panel :global(dd) {
      margin-block-end: 0.6rem;
    }
  }
</style>
