---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_AUTHOR, SITE_LOCALE } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative URL of a sharing image. */
  image?: string;
  /** 'article' for posts and projects, 'website' for everything else. */
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  /** Keep a page out of the index — used for drafts. */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, Astro.site) : undefined;

// The home page title is already the site title; don't say it twice.
const fullTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE_AUTHOR} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_TITLE} — posts`}
  href={new URL('rss.xml', Astro.site)}
/>

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={SITE_LOCALE.replace('-', '_')} />
{socialImage && <meta property="og:image" content={socialImage} />}

<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}

{
  type === 'article' && publishedAt && (
    <meta property="article:published_time" content={publishedAt.toISOString()} />
  )
}
{
  type === 'article' && updatedAt && (
    <meta property="article:modified_time" content={updatedAt.toISOString()} />
  )
}
