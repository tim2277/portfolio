---
import { Picture } from 'astro:assets';

/*
  The crop can't be passed through as an inline style: the CSP has no
  'unsafe-inline' for styles, so a style="" attribute is silently ignored and
  the band falls back to a centred crop — dropping the burnt-in credit out of
  view. Instead each value is echoed into a data attribute and matched by a
  rule in the <style> block below, which ships in the external stylesheet.

  The unions are the contract: a value not listed here fails `astro check`
  rather than rendering with the wrong crop. To add one, extend the union AND
  add the matching [data-hero-position] / [data-hero-ratio] rule below — and
  re-run the converter, since the watermark is placed against this crop.
*/
type HeroPosition = '50% 28%' | '50% 52%';
type HeroRatio = '3.2 / 1';

type BaseProps = {
  title: string;
  /** Small mono line above the title — a section label, not a tagline. */
  eyebrow?: string;
  /**
   * object-position for the crop. The band is far wider than it is tall, so a
   * portrait source loses most of its height — this says which part to keep.
   */
  imagePosition?: HeroPosition;
  /** Override the band's aspect ratio for a taller subject. */
  ratio?: HeroRatio;
};

// Alt text isn't optional when there's an image. Pass an empty string to say
// "decorative" deliberately, rather than by forgetting.
type Props = BaseProps &
  ({ image?: undefined; imageAlt?: never } | { image: ImageMetadata; imageAlt: string });

const { title, eyebrow, image, imageAlt, imagePosition, ratio } = Astro.props;
---

<div class="hero-outer">
  <section class:list={['hero', image && 'has-image']}>
    {
      image && (
        <div
          class="hero-image"
          data-hero-ratio={ratio}
          data-hero-position={imagePosition}
        >
          <Picture
            src={image}
            alt={imageAlt}
            widths={[640, 960, 1280, 1600, 2000]}
            sizes="(max-width: 82rem) 100vw, 82rem"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }

    <div class="hero-inner">
      <div class="hero-body">
        {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        <div class="hero-lede"><slot /></div>
      </div>

      {/* Stands in for a photo. Same chevron language as the favicon. */}
      {
        !image && (
          <svg class="hero-motif" viewBox="0 0 130 120" aria-hidden="true">
            <g
              fill="none"
              stroke="currentColor"
              stroke-width="4"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 22 52 60 20 98" opacity="0.9" />
              <path d="M55 22 87 60 55 98" opacity="0.5" />
              <path d="M90 22 122 60 90 98" opacity="0.22" />
            </g>
          </svg>
        )
      }
    </div>
  </section>
</div>

<style>
  /* Lives outside .wrap, so it spans the header's width rather than the
     reading measure. Edges line up with the wordmark. */
  .hero-outer {
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: var(--gutter);
    margin-block-end: 2.5rem;
  }

  .hero {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-subtle);
  }

  .hero-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(1.5rem, 5vw, 2.5rem) var(--gutter);
  }

  /*
    Text sits under the photo rather than on it. Overlaid copy needs a scrim
    to stay legible, and a scrim heavy enough to pass contrast ruins the
    photograph — so: band, then words.
  */
  .hero-image {
    aspect-ratio: var(--hero-ratio, 3 / 1);
    border-block-end: 1px solid var(--border);
  }

  /* One rule per value in HeroRatio / HeroPosition above. */
  .hero-image[data-hero-ratio='3.2 / 1'] {
    --hero-ratio: 3.2 / 1;
  }

  .hero-image[data-hero-position='50% 28%'] {
    --hero-position: 50% 28%;
  }

  .hero-image[data-hero-position='50% 52%'] {
    --hero-position: 50% 52%;
  }

  /* A fixed ratio that reads well at 600px is a wall at 1250px — flatten the
     band as it widens so it stays a header, not a splash screen. */
  @media (min-width: 64rem) {
    .hero-image {
      aspect-ratio: var(--hero-ratio, 4.5 / 1);
    }
  }

  .hero-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-position, 50% 50%);
  }

  @media (max-width: 40rem) {
    .hero-image {
      aspect-ratio: var(--hero-ratio, 2 / 1);
    }
  }

  .hero-body {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }

  .hero h1 {
    margin-block: 0 0.6rem;
  }

  .hero-lede :global(p) {
    font-family: var(--font-heading);
    font-size: 1.25em;
    line-height: 1.45;
    color: var(--text-muted);
    text-wrap: pretty;
    margin-block: 0 0.8rem;
  }

  .hero-lede :global(p:last-child) {
    margin-block-end: 0;
  }

  .hero-motif {
    flex: none;
    width: clamp(5rem, 18vw, 8.5rem);
    color: var(--accent);
    opacity: 0.5;
  }

  /* Below the measure the motif costs more than it gives. */
  @media (max-width: 34rem) {
    .hero-motif {
      display: none;
    }
  }
</style>
