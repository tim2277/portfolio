---
import type { TimelineYear } from '../lib/content';

interface Props {
  years: TimelineYear[];
  /** The narrow-screen form: a closed <details> above the list. The page
      places one of each, and the stylesheet shows whichever fits. */
  fold?: boolean;
}

const { years, fold = false } = Astro.props;

const posts = (count: number) => `${count} ${count === 1 ? 'post' : 'posts'}`;
---

{
  fold ? (
    <details class="timeline timeline-fold">
      <summary>Jump to a month</summary>
      <nav aria-label="Posts by month">
        <ol>
          {years.map((year) => (
            <li>
              <a href={`#${year.id}`} aria-label={`${year.label}, ${posts(year.count)}`}>
                {year.label} <span class="count">{year.count}</span>
              </a>
              <ol>
                {year.months.map((month) => (
                  <li>
                    <a
                      href={`#${month.id}`}
                      aria-label={`${month.label} ${year.label}, ${posts(month.posts.length)}`}
                    >
                      {month.label} <span class="count">{month.posts.length}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  ) : (
    <aside class="timeline timeline-side" aria-labelledby="timeline-heading">
      <h2 id="timeline-heading" class="timeline-title">
        Timeline
      </h2>
      <nav>
        <ol>
          {years.map((year) => (
            <li>
              <a href={`#${year.id}`} aria-label={`${year.label}, ${posts(year.count)}`}>
                {year.label} <span class="count">{year.count}</span>
              </a>
              <ol>
                {year.months.map((month) => (
                  <li>
                    <a
                      href={`#${month.id}`}
                      aria-label={`${month.label} ${year.label}, ${posts(month.posts.length)}`}
                    >
                      {month.label} <span class="count">{month.posts.length}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  )
}

<style>
  .timeline {
    font-size: 0.875rem;
    line-height: 1.4;
  }

  /* display: none takes the unused one out of the accessibility tree as well,
     so a screen reader meets one list, not two. */
  .timeline-side {
    display: none;
  }

  @media (min-width: 64rem) {
    .timeline-fold {
      display: none;
    }

    .timeline-side {
      display: block;
    }
  }

  /* Follows the reader down the page, but only where there's height to spare —
     a sticky panel taller than the viewport traps its own overflow. */
  @media (min-width: 64rem) and (min-height: 32rem) {
    .timeline-side {
      position: sticky;
      top: 2rem;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
    }
  }

  .timeline-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-muted);
    margin-block: 0 0.75rem;
    padding-block-end: 0.5rem;
    border-block-end: 1px solid var(--border);
  }

  /* Same box as Summary, so a folded list reads as one of the family. */
  .timeline-fold {
    border: 1px solid var(--border);
    border-inline-start: 3px solid var(--accent);
    border-radius: 4px;
    background: var(--bg-subtle);
    margin-block: 0 2rem;
  }

  summary {
    padding: 0.9rem 1.1rem;
    cursor: pointer;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .timeline-fold nav {
    padding: 0 1.1rem 0.9rem;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    margin-block-end: 0.5rem;
  }

  ol ol {
    margin-block-start: 0.5rem;
    padding-inline-start: 0.85rem;
  }

  nav > ol > li > a {
    color: var(--text);
    font-weight: 600;
  }

  a {
    color: var(--text-muted);
    text-decoration: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  a:hover,
  a:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-muted);
  }
</style>
