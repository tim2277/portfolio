---
interface Props {
  title?: string;
}

const { title = 'The short version' } = Astro.props;
---

<details class="summary">
  <summary>{title}</summary>
  <div class="summary-body">
    <slot />
  </div>
</details>

<style>
  /* Same box as Callout, so the two read as one family. */
  .summary {
    border: 1px solid var(--border);
    border-inline-start: 3px solid var(--accent);
    border-radius: 4px;
    background: var(--bg-subtle);
    margin-block: 0 2rem;
  }

  /* The padding sits on the summary, not the box, so the whole bar is the
     click target rather than just the words in it. */
  summary {
    padding: 0.9rem 1.1rem;
    cursor: pointer;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .summary-body {
    padding: 0 1.1rem 0.9rem;
  }

  .summary-body :global(> :first-child) {
    margin-block-start: 0;
  }

  .summary-body :global(> :last-child) {
    margin-block-end: 0;
  }
</style>
