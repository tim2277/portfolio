---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  entries: (CollectionEntry<'posts'> | CollectionEntry<'projects'>)[];
  /** Collection route prefix, e.g. '/posts'. */
  base: string;
  emptyMessage?: string;
  /** Heading level for each entry title. Defaults to h2 — the /posts/ and
      /projects/ indexes, where an entry title is the top-level heading under
      the page's own h1. The home page nests this list under an h2 section
      heading ("Latest posts", "Projects"), so it passes 3 to keep the
      outline from skipping a level. */
  headingLevel?: 2 | 3;
}

const {
  entries,
  base,
  emptyMessage = 'Nothing published here yet.',
  headingLevel = 2,
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

{
  entries.length === 0 ? (
    <p class="muted">{emptyMessage}</p>
  ) : (
    <ul class="entry-list">
      {entries.map((entry) => (
        <li>
          <p class="entry-meta">
            <FormattedDate date={entry.data.date} />
            {'status' in entry.data && <span>· {entry.data.status}</span>}
            {entry.data.draft && <span class="badge-draft">draft</span>}
          </p>
          <Heading class="entry-title">
            <a href={`${base}/${entry.id}/`}>{entry.data.title}</a>
          </Heading>
          <p class="entry-desc">{entry.data.lede ?? entry.data.description}</p>
          {entry.data.tags.length > 0 && (
            <ul class="tags">
              {entry.data.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  )
}
