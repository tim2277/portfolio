{
  // The Astro extension bundles Prettier, which reflows text inside block
  // elements to printWidth. That's right for markup and wrong for prose, and
  // the prose pages (about, colophon, 404) are the ones being hand-written.
  // Format .astro on demand with Shift+Alt+F, not on every save.
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode",
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true
}
